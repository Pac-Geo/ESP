/*
  ESP32-S3 Photo Frame - Power Button & Relay Control Test

  Purpose:
  Tests the basic power-control system that will eventually control
  power to the photo frame monitor.

  Hardware:
  - GPIO21: Power button connected between GPIO21 and GND
  - GPIO42: Relay control output
  - Relay VCC: 5V
  - Relay GND: Common GND with ESP32

  Operation:
  - System starts with the relay OFF.
  - A short button press turns the system ON and energizes the relay.
  - Additional short presses while ON are ignored.
  - Holding the button for 3 seconds turns the system OFF and
    de-energizes the relay.
  - Button input uses the ESP32's internal pull-up resistor.
  - Software debounce prevents false button presses.

  Current Test:
  The relay is controlling a low-voltage LED load for testing.
  Eventually, the relay will control power to the monitor.

  Future additions:
  - ESP32 deep sleep when system is OFF
  - Button wake-up from deep sleep
  - PIR motion detection
  - Automatic monitor sleep after inactivity
  - Scheduled ON/OFF times
*/
#include <Arduino.h>

// -------------------------
// PIN ASSIGNMENTS
// -------------------------
const int RELAY_PIN  = 42;
const int BUTTON_PIN = 21;

// -------------------------
// SETTINGS
// -------------------------
const unsigned long HOLD_TIME = 3000; // 3 seconds
const unsigned long DEBOUNCE_TIME = 40;

// Change these two if your relay module is active LOW
const int RELAY_ON  = HIGH;
const int RELAY_OFF = LOW;

// -------------------------
// STATE
// -------------------------
bool systemOn = false;

bool lastRawButton = HIGH;
bool buttonState = HIGH;

unsigned long lastDebounceTime = 0;
unsigned long pressStartTime = 0;

bool longPressHandled = false;


// =========================================================
// SETUP
// =========================================================

void setup() {

  Serial.begin(115200);

  pinMode(RELAY_PIN, OUTPUT);

  // Button connected:
  // GPIO21 ---- BUTTON ---- GND
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // Start with monitor OFF
  digitalWrite(RELAY_PIN, RELAY_OFF);

  Serial.println();
  Serial.println("Photo Frame Power Controller");
  Serial.println("System OFF");
}


// =========================================================
// LOOP
// =========================================================

void loop() {

  bool rawButton = digitalRead(BUTTON_PIN);

  // -------------------------
  // DEBOUNCE
  // -------------------------

  if (rawButton != lastRawButton) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > DEBOUNCE_TIME) {

    if (rawButton != buttonState) {

      buttonState = rawButton;

      // =========================
      // BUTTON PRESSED
      // =========================

      if (buttonState == LOW) {

        pressStartTime = millis();
        longPressHandled = false;

        // If system is OFF,
        // a normal press immediately turns it ON
        if (!systemOn) {

          systemOn = true;

          digitalWrite(RELAY_PIN, RELAY_ON);

          Serial.println("System ON");
          Serial.println("Monitor relay ON");
        }
      }

      // =========================
      // BUTTON RELEASED
      // =========================

      else {

        longPressHandled = false;
      }
    }
  }

  lastRawButton = rawButton;


  // -------------------------
  // 3 SECOND HOLD TO TURN OFF
  // -------------------------

  if (
      systemOn &&
      buttonState == LOW &&
      !longPressHandled &&
      (millis() - pressStartTime >= HOLD_TIME)
     ) {

    longPressHandled = true;

    systemOn = false;

    digitalWrite(RELAY_PIN, RELAY_OFF);

    Serial.println("3 second hold detected");
    Serial.println("System OFF");
    Serial.println("Monitor relay OFF");
  }
}
