
#include <Arduino.h>
#include <ESP8266WiFi.h>
#include <ESP8266Ping.h>  // Enables pinging Spark
#include <time.h>
#include <utility/time/TimeService.h>
#include "arduino_secrets.h"
#include "thingProperties.h"

#define RELAY_PIN D1  // Existing GPIO5 wiring; HIGH activates the relay.

bool armed = true;
//Spark computer status monitoring
const IPAddress SPARK_IP(10, 0, 0, 103);

// Check Spark every 15 seconds
const uint32_t PING_INTERVAL_MS = 15000;

uint32_t lastPingAt = 0;
bool firstPing = true;

// NEW: Spark startup timer
uint32_t sparkStartTime = 0;
bool sparkTimerRunning = false;

WiFiEventHandler wifiDisconnectHandler;
volatile uint8_t lastDisconnectReason = 0;
volatile uint32_t disconnectCount = 0;
uint32_t lastPrintedDisconnectCount = 0;
uint32_t lastWifiReportAt = 0;
int scanResult = -1;
int matchingAccessPoints = 0;
int32_t strongestSignal = -1000;
int32_t strongestChannel = 0;
uint8_t strongestSecurity = 0;
bool clockWifiWasConnected = false;
bool clockReportedReady = false;

// Arduino Cloud uses this network clock instead of its blocking NTP
// request. Return zero until SNTP has obtained a plausible current timestamp.
unsigned long readNetworkTime() {
    const time_t now = time(nullptr);
    if (now <= 0) {
        return 0;
    }
    const unsigned long utc = static_cast<unsigned long>(now);
    return TimeServiceClass::isTimeValid(utc) ? utc : 0;
}

void serviceNetworkClock() {
    const bool connected = WiFi.status() == WL_CONNECTED;
    if (connected && !clockWifiWasConnected) {
        configTime(0, 0, "time.arduino.cc", "pool.ntp.org", "time.nist.gov");
        Serial.println("CLOCK: background NTP started; waiting for valid time.");
    }
    clockWifiWasConnected = connected;

    const unsigned long utc = readNetworkTime();
    if (utc != 0 && !clockReportedReady) {
        clockReportedReady = true;
        Serial.printf("CLOCK: synchronized; UTC epoch=%lu.\n", utc);
    }
}

void printScanSummary() {
    if (scanResult < 0) {
        Serial.printf("WIFI SCAN: scan failed (%d).\n", scanResult);
    } else if (matchingAccessPoints == 0) {
        Serial.println("WIFI SCAN: configured network NOT FOUND during startup scan.");
    } else {
        Serial.printf("WIFI SCAN: configured network FOUND; matches=%d; "
                      "strongest RSSI=%ld dBm; channel=%ld; security=%u.\n",
                      matchingAccessPoints,
                      static_cast<long>(strongestSignal),
                      static_cast<long>(strongestChannel),
                      static_cast<unsigned int>(strongestSecurity));
    }
}

void reportWifi() {
    Serial.printf("WIFI STATE: status=%d; last disconnect reason=%u; "
                  "disconnect events=%lu.\n",
                  static_cast<int>(WiFi.status()),
                  static_cast<unsigned int>(lastDisconnectReason),
                  static_cast<unsigned long>(disconnectCount));
    if (WiFi.status() == WL_CONNECTED) {
        Serial.printf("WIFI CONNECTED: RSSI=%ld dBm; channel=%ld.\n",
                      static_cast<long>(WiFi.RSSI()),
                      static_cast<long>(WiFi.channel()));
    }
    Serial.printf("CLOCK: %s; CLOUD: %s.\n",
                  readNetworkTime() != 0 ? "valid" : "waiting for NTP",
                  ArduinoCloud.connected() ? "connected" : "not connected");
}
// NEW: Check whether Spark responds to a network ping
// Check whether Spark responds to a network ping
void checkSparkStatus() {
    const uint32_t now = millis();

    // Only check every 15 seconds
    if (!firstPing &&
        (uint32_t)(now - lastPingAt) < PING_INTERVAL_MS) {
        return;
    }

    firstPing = false;
    lastPingAt = now;

    // Ping Spark if connected to Wi-Fi
    const bool reachable =
        WiFi.status() == WL_CONNECTED &&
        Ping.ping(SPARK_IP, 1);

    // Update Arduino Cloud
    sparkReachable = reachable;

    Serial.printf(
        "SPARK STATUS: %s\n",
        reachable ? "REACHABLE" : "NOT REACHABLE"
    );

    // NEW: Stop the startup timer
    if (reachable && sparkTimerRunning) {
        uint32_t elapsedMs = millis() - sparkStartTime;

        sparkTimerRunning = false;

        Serial.printf(
            "SPARK STARTUP TIME: %.1f seconds\n",
            elapsedMs / 1000.0f
        );
    }
}
    

void setup() {
    digitalWrite(RELAY_PIN, LOW);
    pinMode(RELAY_PIN, OUTPUT);

    Serial.begin(9600);
    delay(1500);
    Serial.println("\nSpark Arduino Cloud - background clock 2");
    Serial.println("WIFI: scanning from the ESP's installed location.");

    WiFi.persistent(false);
    WiFi.mode(WIFI_STA);
    scanResult = WiFi.scanNetworks(false, true);
    for (int i = 0; i < scanResult; ++i) {
        // Only report the configured network, not neighboring network names.
        if (WiFi.SSID(i) == SSID) {
            ++matchingAccessPoints;
            if (WiFi.RSSI(i) > strongestSignal) {
                strongestSignal = WiFi.RSSI(i);
                strongestChannel = WiFi.channel(i);
                strongestSecurity = WiFi.encryptionType(i);
            }
        }
    }
    WiFi.scanDelete();
    printScanSummary();

    // Store only the reason/counter in the callback. Print later in loop().
    // Register after the scan so startup scan/mode changes aren't counted.
    wifiDisconnectHandler = WiFi.onStationModeDisconnected(
        [](const WiFiEventStationModeDisconnected& event) {
            lastDisconnectReason = event.reason;
            ++disconnectCount;
        });

    initProperties();
    TimeService.setSyncFunction(readNetworkTime);
    ArduinoCloud.begin(ArduinoIoTPreferredConnection);
    setDebugMessageLevel(2);
    ArduinoCloud.printDebugInfo();
}

void loop() {
    serviceNetworkClock();
    ArduinoCloud.update();
    checkSparkStatus();  //Check Spark every 15 seconds

    const uint32_t events = disconnectCount;
    if (events != lastPrintedDisconnectCount) {
        lastPrintedDisconnectCount = events;
        Serial.printf("WIFI DISCONNECT: reason=%u; events=%lu.\n",
                      static_cast<unsigned int>(lastDisconnectReason),
                      static_cast<unsigned long>(events));
    }
    if (static_cast<uint32_t>(millis() - lastWifiReportAt) >= 10000) {
        lastWifiReportAt = millis();
        reportWifi();
    }
    delay(1);
}

void onPowerRequestChange() {

    if (!powerRequest) {
        armed = true;
        return;
    }

    if (!armed) {
        powerRequest = false;
        return;
    }

    armed = false;
    powerRequest = false;

    // Start timer if Spark is unreachable
    if (!sparkReachable) {
        sparkStartTime = millis();
        sparkTimerRunning = true;

        Serial.println("SPARK: Startup timer started");
    }

    // Original relay operation
    digitalWrite(RELAY_PIN, HIGH);
    delay(300);
    digitalWrite(RELAY_PIN, LOW);
}
